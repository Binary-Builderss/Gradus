# Copia in .env.local e incolla i valori stampati da `supabase start` (API URL e anon key).
# Solo valori pubblici: la service_role key NON va mai qui (le variabili VITE_* finiscono nel bundle).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Facoltative: indirizzo https dove si acquista ciascun piano a pagamento (es. un link di pagamento).
# Finché mancano, il pulsante del piano resta «Presto disponibile».
# VITE_CHECKOUT_URL_MID=
# VITE_CHECKOUT_URL_PRO=
# VITE_CHECKOUT_URL_UNLIMITED=
